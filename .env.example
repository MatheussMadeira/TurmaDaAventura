# --- Site ---
# WhatsApp com DDI + DDD, só dígitos. Valor de exemplo — troque pelo número real antes de publicar.
NEXT_PUBLIC_WHATSAPP=5500000000000
# Domínio público (metadata, Open Graph, JSON-LD, links absolutos).
NEXT_PUBLIC_SITE_URL=https://turmadaaventura.com.br

# --- Banco (Neon / Postgres) ---
# App em runtime: conexão POOLED (host com -pooler).
DATABASE_URL=
# Migrações e seed: conexão DIRETA (sem pooler).
DIRECT_URL=
# Hosts (ou trechos de host) do banco de PRODUÇÃO, separados por vírgula. O seed --force se recusa a
# rodar contra eles (e contra VERCEL_ENV=production). Ex.: ep-abc-123,ep-abc-123-pooler
PRODUCTION_DB_HOSTS=

# --- Autenticação (Auth.js) ---
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
# E-mail da primeira conta de Administração criada pelo seed (a senha temporária sai no terminal, uma vez).
ADMIN_EMAIL=

# --- Fotos (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=
# public (padrão): store PÚBLICO, URL direta do CDN.
# private: alternativa p/ store privado; as fotos são servidas por /api/media/<caminho>.
BLOB_ACCESS=public

# Só o seed destrutivo (npm run db:seed -- --force) em banco de produção. Evite; exige confirmação digitada.
# ALLOW_DESTRUCTIVE_SEED=1
