# WhatsApp com DDI + DDD, só dígitos. Valor de exemplo — troque pelo número real antes de publicar.
NEXT_PUBLIC_WHATSAPP=5500000000000

# Domínio público (metadata, Open Graph, JSON-LD). Exemplo — troque pelo domínio real.
NEXT_PUBLIC_SITE_URL=https://turmadaaventura.com.br

# Etapas 4+ (banco, auth e imagens). Deixe vazio até lá.
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=

# Tipo do store do Vercel Blob: private (padrão; fotos servidas por /api/media) ou public
BLOB_ACCESS=private
ADMIN_EMAIL=
