// Modelo de docs/admin.md. Nenhum campo de preço em nenhum modelo.
// A URL do banco vem de prisma.config.ts (DIRECT_URL para migrar); o app usa DATABASE_URL (pooled) via adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EQUIPE
}

enum PublishStatus {
  RASCUNHO
  PUBLICADO
  PAUSADO
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(EQUIPE)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  media    Media[]
  audits   AuditLog[]
  sections Section[]
}

model Page {
  id       String    @id @default(cuid())
  slug     String    @unique
  title    String
  sections Section[]
}

/// Cada seção da página tem rascunho (draft) e versão publicada (published).
/// Ordem e visibilidade também têm as duas versões; o site público lê só as publicadas.
model Section {
  id               String   @id @default(cuid())
  pageId           String
  page             Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// chave estável dentro da página: "hero", "tres-jeitos"… (data-section = "Pagina/Secao")
  key              String
  /// tipo = nome do schema zod (src/content/sections/schemas.ts)
  type             String
  order            Int
  visible          Boolean  @default(true)
  draft            Json
  published        Json?
  publishedOrder   Int?
  publishedVisible Boolean?
  updatedById      String?
  updatedBy        User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, order])
}

model Region {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  /// nome curto para o overline dos cards da Início ("Pinheiros · Zona Oeste")
  shortName   String
  order       Int
  restaurants Restaurant[]
}

model Restaurant {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  neighborhood String
  schedule     String
  /// endereço sem o bairro: "Rua das Acácias, 000"
  address      String
  ages         String
  mapsUrl      String        @default("")
  regionId     String
  region       Region        @relation(fields: [regionId], references: [id])
  order        Int
  status       PublishStatus @default(RASCUNHO)
  destaqueHome Boolean       @default(false)
  imageId      String?
  image        Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// descrição da foto enquanto não houver mídia (a de Media.alt vale quando houver)
  imageAlt     String        @default("")
  updatedAt    DateTime      @updatedAt

  @@index([regionId, order])
  @@index([status])
}

model Activity {
  id          String        @id @default(cuid())
  slug        String        @unique
  category    String
  icon        String
  title       String
  description String
  tags        String[]
  imageId     String?
  image       Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageAlt    String        @default("")
  order       Int
  status      PublishStatus @default(RASCUNHO)
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
}

model TeamMember {
  id        String   @id @default(cuid())
  nickname  String
  name      String
  role      String
  bio       String
  badges    String[]
  photoId   String?
  photo     Media?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  visible   Boolean  @default(true)
  order     Int
  updatedAt DateTime @updatedAt
}

model Media {
  id                    String   @id @default(cuid())
  /// chave no Vercel Blob da versão "master" (sem EXIF/GPS)
  pathname              String   @unique
  url                   String
  width                 Int
  height                Int
  /// tamanhos gerados: [{ width, height, url }] em WebP
  variants              Json
  /// descrição da imagem — OBRIGATÓRIA (acessibilidade)
  alt                   String
  authorizationConfirmed Boolean  @default(false)
  createdById           String?
  createdBy             User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())

  restaurants Restaurant[]
  activities  Activity[]
  team        TeamMember[]
}

/// Linha única (id = "site").
model SiteSettings {
  id        String   @id @default("site")
  whatsapp  String
  instagram String
  email     String   @default("")
  city      String
  hours     String
  /// mensagem pronta por página: { inicio, oficina, restaurantes, "eventos-corporativos", "quem-somos", float }
  messages  Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// o que mudou, onde e se foi publicado — alimenta "Últimas alterações"
  action    String
  entity    String
  entityId  String?
  summary   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
